rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      // Allow read/write access to own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Allow customers to read shop profiles (for finding nearby shops)
      allow read: if request.auth != null &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'customer' &&
                   resource.data.userType == 'shop';
    }

    // Search requests collection
    match /searchRequests/{requestId} {
      // Allow customers to create search requests
      allow create: if request.auth != null &&
                     request.auth.uid == request.resource.data.customerId &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'customer';

      // Allow shops to read and update requests sent to them
      allow read, update: if request.auth != null &&
                           request.auth.uid == resource.data.shopId &&
                           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'shop';

      // Allow customers to read their own requests
      allow read: if request.auth != null &&
                   request.auth.uid == resource.data.customerId &&
                   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'customer';
    }
  }
}